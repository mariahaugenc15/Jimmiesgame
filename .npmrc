# apps/server has zero use for React, but pnpm's default workspace-wide
# optional-peer resolution was attaching @lockedin/web's react/@types/react
# to drizzle-orm anyway (it declares react as an optional peer for its
# live-query hooks). That pulled in drizzle-orm's React-integration type
# declarations and produced a genuine TS type mismatch
# ("private property 'shouldInlineParams'") purely from that unwanted
# variant, unrelated to any of our own code. Scoping peer resolution to
# each workspace package's own dependency graph stops the cross-contamination.
resolve-peers-from-workspace-root=false
auto-install-peers=false
